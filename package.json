{
  "name": "cat-window",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A painted cat that lives behind your screen. Pet it, feed it, earn its trust.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node tools/shots.mjs",
    "cap:sync": "npm run build && cap sync",
    "artifact": "node tools/artifact.mjs artifact-dist"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.180.0",
    "galmuri": "^2.40.3",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
